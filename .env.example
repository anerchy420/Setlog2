# setlog2 サーバーの設定。このファイルを「.env」という名前でコピーして書き換えます。

# 待ち受けるポート（Cloudflare Tunnel の転送先 http://localhost:8787 と合わせる）
PORT=8787

# 待ち受けるアドレス。127.0.0.1 のままにすると、Cloudflare Tunnel 経由でしか外から入れません（推奨）
HOST=127.0.0.1

# 公開URL（Cloudflareで設定したアドレス）。通知の送信元として使います
PUBLIC_URL=https://setlog.example.com

# 通知の送信者の連絡先（mailto: か https://）。空なら PUBLIC_URL を使います
VAPID_SUBJECT=mailto:you@example.com

# 合言葉。設定すると、アカウントを作るときに入力が必要（知らない人の登録を防ぐ）。空なら誰でも登録できます
SIGNUP_CODE=

# 何日より前の動画を自動で消すか（0 = 消さない）
RETENTION_DAYS=0

# 毎時通知の基準にするタイムゾーン（端末から届かなかったときに使う）
DEFAULT_TZ=Asia/Tokyo

# データの保存先（setlog.db と media/）
DATA_DIR=data
