# Linux（systemd）で自動起動する場合の例
#   sudo cp deploy/setlog2.service /etc/systemd/system/
#   sudo systemctl enable --now setlog2
[Unit]
Description=setlog2
After=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Setlog2
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
